# Lavanya Collections - Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# If left blank or connection fails in development, in-memory MongoDB will be used automatically
MONGODB_URI=mongodb://localhost:27017/lavanya_collections

# JWT Secret for Authentication
JWT_SECRET=lavanya_boutique_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Admin Seed Account (Used on initial seed)
ADMIN_NAME="Lavanya Admin"
ADMIN_EMAIL=lavanyacollections@gmail.com
ADMIN_PASSWORD=lavanyacollect
ADMIN_PHONE=+919876543210

# Razorpay Payment Gateway (Test Mode / Live Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret

# Cloudinary Storage (Optional - falls back to local disk /uploads if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp Business Cloud API (Optional - falls back to mock logger if empty)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=order_confirmed
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=payment_received
WHATSAPP_TEMPLATE_QUOTATION_READY=quotation_ready
WHATSAPP_TEMPLATE_RENTAL_REMINDER=rental_reminder
